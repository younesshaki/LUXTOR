{
  "name": "luxtor-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "bash -lc 'set -a && source .env.local && set +a && prisma generate'",
    "db:push": "bash -lc 'set -a && source .env.local && set +a && prisma db push'",
    "db:seed": "bash -lc 'set -a && source .env.local && set +a && prisma db seed'",
    "db:migrate": "bash -lc 'set -a && source .env.local && set +a && prisma migrate dev'",
    "db:studio": "bash -lc 'set -a && source .env.local && set +a && prisma studio'"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.21",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.2",
    "split-type": "^0.3.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "^6.17.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
