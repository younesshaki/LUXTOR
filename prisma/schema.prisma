generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
}

enum LeadSubmissionType {
  quote
  contact
}

enum LeadSubmissionStatus {
  submitted
  under_review
  contacted
  converted
  closed
}

enum OdooSyncStatus {
  pending
  queued
  synced
  failed
}

enum OutboxEntityType {
  lead_submission
  user
}

enum OutboxEventType {
  lead_submission_created
  lead_submission_updated
  user_verified
}

enum OutboxStatus {
  pending
  processing
  processed
  failed
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  emailVerified DateTime?
  passwordHash  String
  role          UserRole         @default(customer)
  fullName      String?
  phone         String?
  suburb        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  accounts      Account[]
  sessions      Session[]
  submissions   LeadSubmission[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LeadSubmission {
  id             String               @id @default(cuid())
  type           LeadSubmissionType
  status         LeadSubmissionStatus @default(submitted)
  userId         String?
  fullName       String
  email          String
  phone          String?
  suburb         String?
  serviceInterest String?
  message        String?              @db.Text
  sourcePage     String
  sourceVariant  String?
  internalNotes  String?              @db.Text
  odooSyncStatus OdooSyncStatus       @default(pending)
  odooExternalId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  outboxEvents   IntegrationOutbox[]

  @@index([email])
  @@index([status])
  @@index([odooSyncStatus])
}

model IntegrationOutbox {
  id            String          @id @default(cuid())
  entityType    OutboxEntityType
  entityId      String
  eventType     OutboxEventType
  payload       Json
  status        OutboxStatus    @default(pending)
  attemptCount  Int             @default(0)
  lastError     String?         @db.Text
  nextRetryAt   DateTime?
  processedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  leadSubmissionId String?
  leadSubmission   LeadSubmission? @relation(fields: [leadSubmissionId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([status, nextRetryAt])
}
